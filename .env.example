DB_URL=jdbc:postgresql://localhost:5432/salon_management
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=your_jwt_secret_here_min_32_chars
# Email OTP via SMTP (Gmail). Create a Gmail App Password (Google Account →
# Security → 2-Step Verification → App passwords) and put it in MAIL_PASSWORD.
# Never commit real values. The app boots without them; registration answers
# EMAIL_SEND_FAILED (502) until configured.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Smart Salon
# OTP policy (defaults shown).
APP_OTP_TTL_MINUTES=10
APP_OTP_RESEND_COOLDOWN_SECONDS=60
